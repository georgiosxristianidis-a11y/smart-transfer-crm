{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "globals": {
    "Chart": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "security"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:security/recommended-legacy"
  ],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "security/detect-object-injection": "off"
  }
}
